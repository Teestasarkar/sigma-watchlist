# ─── Everything here is optional. With no .env at all the app runs on
# ─── embedded Postgres with a simulated market feed.

# Managed Postgres. When set, the app uses it instead of embedded Postgres.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Where embedded Postgres keeps its files (ignored when DATABASE_URL is set).
# DATA_DIR=data/pg

# HTTP
# PORT=8787
# HOST=127.0.0.1
# Serve the built frontend from the API process (single-origin production).
# SERVE_WEB=0
# Comma-separated extra allowed origins; localhost is always allowed.
# CORS_ORIGINS=https://example.com

# ─── Market data ────────────────────────────────────────────────────────
# Ordered by preference. The FIRST entry also decides which market clock the
# whole system runs on, so ordering is not cosmetic. Live and simulated feeds
# are mutually exclusive and enforced at startup.
#
#   yahoo            live prices + a year of history, no API key  (default)
#   yahoo,finnhub    two live sources, real cross-vendor reconciliation
#   synthetic        deterministic simulator, always moving, Lab shocks work
#   synthetic,synthetic-alt   two simulated sources, to demo disagreement
#
# PROVIDERS=yahoo
# FINNHUB_API_KEY=

# Password for the seeded demo account. Published in the UI on purpose.
# DEMO_PASSWORD=sigma-demo-2026

# Same seed produces the same market, every run.
# SYNTHETIC_SEED=20260904
# Wall-clock ms per simulated session. Volatility horizons are scaled by the
# same constant, so the significance figures stay honest at any speed.
# SYNTHETIC_SESSION_MS=45000
# HISTORY_SESSIONS=260

# ─── What counts as meaningful ──────────────────────────────────────────
# Enter an episode at this many sigma, leave it at SIGMA_EXIT. The gap between
# them is the dead band that stops a value oscillating around one threshold
# from opening and closing episodes on every poll.
# SIGMA_ENTER=2.0
# SIGMA_EXIT=1.0
# IDIO_ENTER=2.0
# RVOL_ENTER=2.5
# VOL_REGIME_ENTER=1.8
# MIN_BARS_FOR_STATS=25

# ─── The briefing ───────────────────────────────────────────────────────
# DIGEST_MAX_ITEMS=12
# DIGEST_MAX_PER_SYMBOL=2
# Lookback in *trading sessions*, not milliseconds - the only unit that means
# the same thing to a live exchange and to the compressed simulator clock.
# DIGEST_FIRST_LOOKBACK_SESSIONS=3
# DIGEST_MAX_LOOKBACK_SESSIONS=10

# Replaying stored history through the detectors on startup, so a fresh
# instance has a real signal timeline rather than an empty briefing.
# REPLAY_HISTORY=1
# REPLAY_SESSIONS=12

# ─── Operations ─────────────────────────────────────────────────────────
# INGEST_ENABLED=1
# DEV_TOOLS=1
# LOG_LEVEL=info
# LOG_JSON=0
